# Copy this file to .env, fill it in, then run `npm run build` again.
# Leave the two Supabase lines empty to run in demo mode (sample data, no sign-in, no backend).

# Where the backend runs (npm start inside /backend)
VITE_API_URL=http://localhost:3000

# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
